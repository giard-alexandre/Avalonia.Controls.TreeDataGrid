<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:TreeDataGridDemo.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="viewModels:StringConvertViewModel" x:CompileBindings="True"
             x:Class="TreeDataGridDemo.StringConvertView">
  <DockPanel>
        <WrapPanel Orientation="Horizontal" DockPanel.Dock="Top">
            <WrapPanel.Styles>
                <Style Selector="StackPanel">
                    <Setter Property="Orientation" Value="Horizontal" />
                    <Setter Property="Margin" Value="5" />
                </Style>
            </WrapPanel.Styles>
            <StackPanel>
                <Label Target="FilterTextBox">Filter Name: </Label>
                <TextBox Name="FilterTextBox" Text="{Binding FilterText}" Width="200" />
            </StackPanel>
          <Button Content="Change Item" Command="{Binding ChangeNameCommand}" />
        </WrapPanel>
        <TreeDataGrid Source="{Binding DataSource}">
            <TreeDataGrid.Resources>
                <DataTemplate x:Key="HeightCell" DataType="{x:Type viewModels:Person}">
                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center"
                               Text="{Binding Height, StringFormat={}{0:0.0}}" />
                </DataTemplate>
                <DataTemplate x:Key="HobbiesCell" DataType="{x:Type viewModels:Person}">
                    <ItemsControl ItemsSource="{Binding Hobbies}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="5" VerticalAlignment="Center"
                                        Background="Gray" Padding="2">
                                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center"
                                               Text="{Binding .}" FontSize="8" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DataTemplate>
                <DataTemplate x:Key="LanguagesCell" DataType="{x:Type viewModels:Person}">
                    <ItemsControl ItemsSource="{Binding LanguagesSpoken}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="5" VerticalAlignment="Center"
                                        Background="OliveDrab" Padding="2">
                                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center"
                                               Text="{Binding .}" FontSize="8" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DataTemplate>
            </TreeDataGrid.Resources>
        </TreeDataGrid>
    </DockPanel>
</UserControl>
